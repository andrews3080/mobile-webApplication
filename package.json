{
  "name": "asaase-ani",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit -p apps/api && tsc --noEmit -p apps/web",
    "dev:api": "npm run dev -w @asaase-ani/api",
    "migrate": "npm run migrate -w @asaase-ani/api",
    "dev:web": "npm run dev -w @asaase-ani/web"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  }
}
