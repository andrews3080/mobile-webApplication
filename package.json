{
  "name": "asaase-ani",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit -p packages/shared && tsc --noEmit -p apps/api && tsc --noEmit -p apps/web && tsc --noEmit -p apps/mobile",
    "dev:api": "npm run dev -w @asaase-ani/api",
    "migrate": "npm run migrate -w @asaase-ani/api",
    "dev:web": "npm run dev -w @asaase-ani/web",
    "dev:mobile": "npm run start -w @asaase-ani/mobile"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  },
  "overrides": {
    "react": "19.3.0",
    "react-dom": "19.3.0"
  }
}
