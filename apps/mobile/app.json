    "primaryColor": "#1f6b45",
    "backgroundColor": "#f2f5f3",
    "android": {
      "package": "gh.edu.ug.asaaseani.officer",
      "softwareKeyboardLayoutMode": "pan",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#f5f1e6"
      }
    },
    "ios": {
      "bundleIdentifier": "gh.edu.ug.asaaseani.officer"
    },
    "plugins": [
      "expo-secure-store",
      "expo-status-bar"
    ],
    "icon": "./assets/icon.png",
    "web": {
      "favicon": "./assets/favicon.png"
    }
  }
}
